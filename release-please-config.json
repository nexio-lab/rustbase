{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "packages": {
    ".": {
      "package-name": "rustbase",
      "include-component-in-tag": false,
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "generic",
          "path": "Cargo.toml"
        }
      ]
    }
  },
  "include-v-in-tag": true,
  "tag-separator": "",
  "pull-request-title-pattern": "release: ${version}",
  "pull-request-header": "Auto-generated release PR. Merging this PR cuts a new tag (`v${version}`); the published-release event then triggers `.github/workflows/release.yml`, which builds the cross-platform binaries + GHCR image and attaches them to the release.",
  "draft": false,
  "prerelease": false,
  "separate-pull-requests": false,
  "changelog-sections": [
    { "type": "feat",     "section": "Added" },
    { "type": "fix",      "section": "Fixed" },
    { "type": "perf",     "section": "Performance" },
    { "type": "refactor", "section": "Changed" },
    { "type": "docs",     "section": "Documentation" },
    { "type": "build",    "section": "Build" },
    { "type": "ci",       "section": "CI" },
    { "type": "chore",    "section": "Chore", "hidden": true },
    { "type": "test",     "section": "Tests", "hidden": true },
    { "type": "style",    "section": "Style", "hidden": true }
  ]
}
