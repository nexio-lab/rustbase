# Rust
/target
**/target/
*.pdb

# Data directory (runtime state)
/data
*.db
*.db-wal
*.db-shm

# Local config & secrets
/.env
/.env.*
!/.env.example
rustbase.toml

# Editor / OS
.DS_Store
.idea/
