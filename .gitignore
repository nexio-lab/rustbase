# Rust
/target
**/target/
*.pdb

# Data directory (runtime state)
/data
*.db
*.db-wal
*.db-shm

# Local config & secrets
/.env
/.env.*
!/.env.example
rustbase.toml

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp
*.swo
*~

# Local-only docs
CLAUDE.md
HANDOFF.md

# Dashboard build artifacts. ui/.gitignore covers node_modules,
# /build, and the .svelte-kit cache. The Rust build.rs in
# rustbase-server runs `bun --cwd ui run build` to produce ui/build/
# on demand, so the artifact lives only in target/.

# Override the user-level global ignore that strips out docs/ —
# we want the VitePress source tracked. docs/.gitignore handles
# the per-folder exclusions (node_modules, dist, cache).
!/docs/
!/docs/**
